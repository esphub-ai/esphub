{
  "name": "esphub-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "esphub.ai/*", "zone_name": "esphub.ai" },
    { "pattern": "www.esphub.ai/*", "zone_name": "esphub.ai" },
    { "pattern": "app.esphub.ai/*", "zone_name": "esphub.ai" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [{ "binding": "API", "service": "esphub-api" }]
}
