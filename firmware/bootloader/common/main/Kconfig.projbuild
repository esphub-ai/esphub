menu "esp-bootloader"

    config OKL_USB_CDC
        bool "USB OTG CDC provisioning console"
        depends on IDF_TARGET_ESP32S31 && TINYUSB_CDC_ENABLED

    config OKL_URL_OTA
        bool
        default y

    config OKL_AUTOSTART_MS
        int "Auto-start the app this long after boot (ms)"
        default 3000

    config OKL_FAILSAFE_WAIT_S
        int "Auto-start delay after an app rollback (s)"
        default 30
        help
            After an app rollback, the bootloader waits longer before starting the app
            again so an operator can intervene. Any hub request cancels auto-start.

endmenu
