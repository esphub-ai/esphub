{
  "name": "esphub-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {"crons":["17 */6 * * *"]},
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.esphub.ai", "custom_domain": true },
    { "pattern": "cdn.esphub.ai", "custom_domain": true }
  ],
  "images": { "binding": "IMAGES" },
  "vars": { "APP_ORIGIN": "https://app.esphub.ai", "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsuZXNwaHViLmFpJA" },
  "durable_objects": {
    "bindings": [{ "name": "DEVICE", "class_name": "Device" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Device"] }],
  "r2_buckets": [{ "binding": "UART", "bucket_name": "esphub-production" }, { "binding": "FIRMWARE", "bucket_name": "esphub-firmware" }]
}
