CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Match the maximum filename length on MicroPython-formatted LittleFS volumes.
CONFIG_LITTLEFS_OBJ_NAME_LEN=256
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y

CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# The launcher connects to MQTT on port 8883 and downloads artifacts over HTTPS.
CONFIG_MQTT_TRANSPORT_SSL=y
CONFIG_WS_TRANSPORT=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_WEBSOCKET_SECURE=n

# Provisioning scans for the host beacon, then accepts its BLE connection.
# Wi-Fi only joins existing networks.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
